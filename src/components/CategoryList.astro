---
// Liste de catégories d'un article : composant PARTAGÉ (page d'article, carte de résumé, résultats de recherche).
// Les catégories viennent toujours de `article.categories` (src/data/articles.js), jamais écrites en dur ici.
// variant="chips" : pastilles de l'en-tête de l'article (la 1re en bleu clair, les autres en gris)
// variant="tags"  : pastilles avec icône « étiquette » (carte de résumé)
import '../styles/category-list.css';
const { categories = [], variant = 'chips' } = Astro.props;
---
{categories.length > 0 && (
  <ul class={`category-list category-list--${variant}`} aria-label="Catégories">
    {categories.map((category) => (
      <li class="category-list__item">
        {variant === 'tags' && (
          <svg class="category-list__icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path>
            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
          </svg>
        )}
        {category}
      </li>
    ))}
  </ul>
)}
