---
// Carte d'article (page d'accueil : « Articles en vedette »).
// Réutilisable : on lui passe un titre, un extrait, des tags, une image et un lien.
// Toute la carte est cliquable : le lien est placé sur le titre (accessible au clavier et aux lecteurs
// d'écran) et étendu à toute la carte en CSS (.article-card__link::after). Un seul lien par carte,
// donc pas de liens imbriqués. Le bouton « Voir plus » est un simple repère visuel.
import '../styles/article-card.css';

const {
  title,
  excerpt,
  tags = [],
  // Image provisoire par défaut si l'article n'a pas d'image
  image = '/images/article-default.jpg',
  imageAlt = '',
  href = '#',
} = Astro.props;
---
<article class="article-card">
  <img class="article-card__image" src={image} alt={imageAlt} width="712" height="384" loading="lazy" />
  <div class="article-card__body">
    <h3 class="article-card__title">
      <a class="article-card__link" href={href}>{title}</a>
    </h3>
    <p class="article-card__excerpt">{excerpt}</p>
    {tags.length > 0 && (
      <ul class="article-card__tags">
        {tags.map((tag) => (
          <li class="article-card__tag">{tag}</li>
        ))}
      </ul>
    )}
    <div class="article-card__actions">
      <!-- Décoratif : toute la carte est cliquable via le lien du titre (un seul lien par carte). -->
      <span class="article-card__button article-card__button--solid" aria-hidden="true">Voir plus</span>
    </div>
  </div>
</article>
