---
// Section « Info-VAE : La VAE, c'est plus simple qu'il n'y paraît ! » + formulaire d'inscription.
// Réutilisable : cette même section apparaît en bas de la page d'article sur la référence.
import '../styles/info-session.css';
import Icon from './Icon.astro';
---
<section class="info-session">
  <div class="container info-session__grid">
    <div class="info-session__content">
      <!-- Vignette PROVISOIRE (96 × 54 px) : à remplacer par l'image définitive -->
      <img class="info-session__thumb" src="/images/session-vignette.svg" alt="" width="96" height="54" />
      <h2 class="info-session__title">Info-VAE : La VAE, c'est plus simple qu'il n'y paraît !</h2>
      <p class="info-session__text">Session d'information <strong>gratuite</strong> sur la VAE</p>
      <p class="info-session__text">En visio ce mercredi à 19h</p>
      <div class="info-session__icons" aria-hidden="true">
        <span class="info-session__icon"><Icon name="webcam" size={44} /></span>
        <span class="info-session__icon"><Icon name="calendar" size={44} /></span>
      </div>
    </div>

    <div class="info-session__form-wrap">
      <!-- Deux cercles décoratifs : l'un en haut à droite de la carte, l'autre qui chevauche son coin inférieur -->
      <span class="info-session__circle info-session__circle--cream" aria-hidden="true"></span>
      <span class="info-session__circle info-session__circle--yellow" aria-hidden="true"></span>

      <!-- Formulaire relié à /api/contact (netlify/functions/contact.mjs) : chaque envoi valide crée une ligne
           dans le Google Sheets « Info VAE – Contacts ». Trois champs seulement : Prénom, Nom, Email. -->
      <form class="info-session__form" id="signup-form" novalidate>
        <label class="info-session__label" for="signup-firstname">Prénom</label>
        <input class="info-session__input" id="signup-firstname" name="firstname" type="text" placeholder="Prénom" autocomplete="given-name" required />
        <label class="info-session__label" for="signup-lastname">Nom</label>
        <input class="info-session__input" id="signup-lastname" name="lastname" type="text" placeholder="Nom" autocomplete="family-name" required />
        <label class="info-session__label" for="signup-email">Email</label>
        <input class="info-session__input" id="signup-email" name="email" type="email" placeholder="Email" autocomplete="email" required />
        <button class="info-session__submit" type="submit">S'inscrire</button>
        <p class="info-session__status" id="signup-status" role="status" hidden></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Envoi du formulaire vers /api/contact (fonction Netlify → Google Sheets « Info VAE – Contacts »).
  // Contrôle immédiat des 3 champs dans le navigateur ; le contrôle qui fait foi est celui du serveur.
  const form = document.getElementById('signup-form');
  const status = document.getElementById('signup-status');
  const openedAt = Date.now(); // sert d'anti-spam : un robot envoie le formulaire immédiatement
  const EMAIL_RE = /^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]{2,}$/;

  function show(state, message) {
    status.hidden = false;
    status.dataset.state = state;
    status.textContent = message;
  }

  if (form && status) {
    const button = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = form.elements.email;
      email.setCustomValidity(EMAIL_RE.test(email.value.trim()) ? '' : "Veuillez saisir une adresse e-mail valide (exemple : nom@domaine.fr).");
      if (!form.checkValidity()) {
        form.reportValidity(); // affiche les messages natifs du navigateur
        return;
      }
      button.disabled = true;
      show('pending', 'Envoi en cours…');
      try {
        // Un visiteur très rapide (remplissage automatique) attend un instant : le serveur refuse les envois instantanés.
        const wait = 3000 - (Date.now() - openedAt);
        if (wait > 0) await new Promise((resolve) => setTimeout(resolve, wait));
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstname: form.elements.firstname.value,
            lastname: form.elements.lastname.value,
            email: form.elements.email.value,
            elapsed: Date.now() - openedAt,
            // Origine du visiteur (UTM mémorisés par le gabarit) : facultatif, jamais affiché ni bloquant.
            utm: typeof window.infoVaeUtm === 'function' ? window.infoVaeUtm() : {},
          }),
        });
        const result = await response.json().catch(() => null);
        if (response.ok && result && result.ok) {
          form.reset();
          show('success', 'Merci ! Votre inscription a bien été enregistrée. Nous reviendrons vers vous très prochainement.');
        } else if (response.status === 422) {
          show('error', "Certaines informations ne sont pas valides. Vérifiez votre prénom, votre nom et votre adresse e-mail.");
        } else if (response.status === 429) {
          show('error', 'Trop de tentatives. Merci de réessayer dans quelques minutes.');
        } else {
          show('error', "Votre inscription n'a pas pu être enregistrée. Merci de réessayer un peu plus tard.");
        }
      } catch (error) {
        show('error', "Impossible de contacter le serveur. Vérifiez votre connexion et réessayez.");
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
