---
// Petites icônes SVG réutilisables (style « traits arrondis », comme la référence).
// Utilisation : <Icon name="phone" size={16} />
// Noms disponibles : phone, clock, mail, webcam, calendar
const { name, size = 16 } = Astro.props;
---
{name === 'webcam' || name === 'calendar' ? (
  <svg class="icon" width={size} height={size} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'webcam' && (
      <>
        <rect x="2" y="4" width="44" height="40" rx="6"></rect>
        <circle cx="15" cy="18" r="4.5"></circle>
        <circle cx="33" cy="18" r="4.5"></circle>
        <path d="M11 34h26"></path>
      </>
    )}
    {name === 'calendar' && (
      <>
        <rect x="4" y="6" width="40" height="36" rx="6"></rect>
        <path d="M4 15h40"></path>
        <g fill="currentColor" stroke="none">
          <circle cx="13" cy="25" r="2.4"></circle>
          <circle cx="24" cy="25" r="2.4"></circle>
          <circle cx="35" cy="25" r="2.4"></circle>
          <circle cx="13" cy="33" r="2.4"></circle>
          <circle cx="24" cy="33" r="2.4"></circle>
          <circle cx="35" cy="33" r="2.4"></circle>
        </g>
      </>
    )}
  </svg>
) : (
  <svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'phone' && (
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    )}
    {name === 'clock' && (
      <>
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 6v6l4 2"></path>
      </>
    )}
    {name === 'mail' && (
      <>
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </>
    )}
  </svg>
)}
