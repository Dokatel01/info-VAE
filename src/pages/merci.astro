---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Merci | Info VAE" description="Votre demande a été prise en compte.">
  <div class="container" style="max-width: 650px; margin: 4rem auto; text-align: center; padding: 0 1rem;">
    <h1 style="color: #10b981; font-size: 2.2rem; margin-bottom: 1rem;">Demande bien reçue !</h1>
    <p style="font-size: 1.15rem; line-height: 1.6; color: #374151;">
      Merci pour vos réponses. Votre éligibilité a été enregistrée avec succès. Un conseiller va analyser votre dossier.
    </p>
    <div style="margin-top: 2rem;">
      <a href="/" class="vq-primary" style="display: inline-block; padding: 0.75rem 1.5rem; text-decoration: none; border-radius: 6px; background-color: #2563eb; color: #fff;">
        Retour à l'accueil
      </a>
    </div>
  </div>
</BaseLayout>